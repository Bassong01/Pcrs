body{font-family:Arial;color:#17252b;font-size:10.5pt;margin:2cm}h1{color:#075852;font-size:24pt}h2{color:#087f78;border-bottom:1px solid #dce5e4;padding-bottom:4px}h3{color:#075852}.subtitle{color:#748187;font-size:14pt}.figure{text-align:center;margin:18px 0}.figure img{max-width:680px;width:90%;border:1px solid #dce5e4}.note{background:#e3f4ed;padding:10px}.step{margin:6px 0}.small{color:#748187}
